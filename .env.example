# ==============================================
# AI English-Chinese Dictionary Configuration
# ==============================================
# 複製此文件為 .env 並填入您的配置值

# ----------------------------------------------
# Flask 配置
# ----------------------------------------------
# 會話管理密鑰（生產環境必需）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# 環境：development, production, 或 testing
FLASK_ENV=development

# 啟用除錯模式 (True/False)
FLASK_DEBUG=True

# 綁定主機
FLASK_HOST=0.0.0.0

# 監聽端口
FLASK_PORT=3217

# ----------------------------------------------
# 資料庫配置
# ----------------------------------------------
# SQLite（預設，用於開發）
DATABASE_URL=sqlite:///dictionary.db

# PostgreSQL（用於生產環境）
# DATABASE_URL=postgresql://username:password@localhost:5432/aiengdict

# MySQL（替代方案）
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/aiengdict

# ----------------------------------------------
# AI 配置
# ----------------------------------------------
# Google Gemini API Key（必需）
# 獲取密鑰：https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini 模型
# 選項：gemini-2.5-flash, gemini-pro 等
GEMINI_MODEL=gemini-2.5-flash

# 提示詞風格
# 選項：standard, detailed
PROMPT_STYLE=detailed

# ----------------------------------------------
# 安全配置
# ----------------------------------------------
# 上傳內容最大長度（位元組）
# 預設：16MB
MAX_CONTENT_LENGTH=16777216

# 啟用速率限制 (True/False)
RATELIMIT_ENABLED=False

# 預設速率限制
RATELIMIT_DEFAULT=200 per day, 50 per hour

# ----------------------------------------------
# 可選：跳過配置驗證
# ----------------------------------------------
# 設為 "true" 可跳過啟動時的配置驗證
# SKIP_CONFIG_VALIDATION=false
